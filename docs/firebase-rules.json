{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$id": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "$id.matches(/^[a-km-np-z2-9]{12}$/) && newData.hasChildren(['o', 't'])",
        "o": { ".validate": "newData.isString() && newData.val().length < 8000" },
        "t": { ".validate": "newData.val() == now" },
        "a": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.isString() && newData.val().length < 8000"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
